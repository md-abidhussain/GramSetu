# GramSetu AI — Environment Configuration

# Server settings
PORT=5000

# Database Settings (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gramsetu

# JWT Token Security Settings
JWT_SECRET=super_secure_jwt_token_secret_phrase

# Google Gemini API key (Obtained from Google AI Studio)
GEMINI_API_KEY=AIzaSyD...
 
# Cloudinary Storage settings for Project Images & Tender PDFs
CLOUDINARY_CLOUD_NAME=d...
CLOUDINARY_API_KEY=1...
CLOUDINARY_API_SECRET=e...

# Required local YOLOv8 segmentation service for AI defect quantification.
SEGMENTATION_SERVICE_URL=http://localhost:8001
SEGMENTATION_MIN_CONFIDENCE=0.35     

 
  


