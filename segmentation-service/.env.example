# "production" refuses demo mode. Use "development" locally.
SEGMENTATION_ENV=production
MODEL_PATH=models/model.onnx
# Opt-in placeholder output for UI demos when no model is available (development only).
SEGMENTATION_DEMO_MODE=false
# If set, the API server must send the same value (SEGMENTATION_SERVICE_TOKEN there).
SEGMENTATION_SERVICE_TOKEN=
MAX_UPLOAD_MB=8
