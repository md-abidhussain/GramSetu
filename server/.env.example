# GramSetu API server. Copy to server/.env for local development.
# Never commit .env. In production, set these in your host's dashboard (Render, etc.).

# --- Required -----------------------------------------------------------------
# MongoDB connection string (Atlas: Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gramsetu

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start with a short or published example value.
JWT_SECRET=

# Comma-separated front-end URL(s) allowed to call the API. Required in production.
CLIENT_ORIGINS=http://localhost:3000

# --- Runtime --------------------------------------------------------------------
PORT=5000
# "production" turns on Secure cookies and production-only safety checks.
NODE_ENV=development
# Number of proxies in front of the server (Render = 1). Needed for per-user rate limits.
TRUST_PROXY=

# --- File storage ---------------------------------------------------------------
# Cloudinary (required in production for uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Development only: store uploads on local disk instead of Cloudinary.
# STORAGE_DRIVER=local

# --- AI -----------------------------------------------------------------------
# Google AI Studio key. Without it, AI analysis is recorded as "not configured"
# and no AI scores are produced (nothing is made up).
GEMINI_API_KEY=
# Optional override of the Gemini model name.
# GEMINI_MODEL=

# Defect detection service (segmentation-service/). Leave empty if not deployed.
SEGMENTATION_SERVICE_URL=
# Must match SEGMENTATION_SERVICE_TOKEN on the detection service, if set there.
SEGMENTATION_SERVICE_TOKEN=
SEGMENTATION_MIN_CONFIDENCE=0.35

# --- Demo data ----------------------------------------------------------------
# Leave unset in production.
#   true  = seed only when the database is empty
#   force = wipe and reseed (refused in production)
SEED_DB=
# Seeds an Admin account only when set (12+ characters). Never use a published value.
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@gramsetu.gov

# --- Optional tuning ------------------------------------------------------------
# AUTH_RATE_LIMIT_MAX=20        # sign-in attempts per 15 minutes per IP
# UPLOAD_RATE_LIMIT_MAX=30      # uploads per hour per IP
# GLOBAL_RATE_LIMIT_MAX=300     # API requests per minute per IP
# MONGODB_DNS_SERVERS=8.8.8.8,8.8.4.4   # only if your network cannot resolve Atlas SRV records
