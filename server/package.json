{
  "name": "gramsetu-ai-server",
  "version": "1.0.0",
  "description": "GramSetu API server",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/http/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:http": "node --test --test-concurrency=1 \"tests/http/*.test.js\"",
    "lint": "eslint .",
    "smoke": "node scripts/smoke.js",
    "loadtest": "node scripts/loadtest.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
